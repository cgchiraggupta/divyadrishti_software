# Copy this file to .env and fill in your own Supabase project credentials.
# Find these under Supabase Dashboard -> Project Settings -> API.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key

# Set to true to preview the app with local sample data and no authentication.
VITE_DEMO_MODE=false
