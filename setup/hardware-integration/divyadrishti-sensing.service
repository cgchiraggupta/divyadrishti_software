[Unit]
Description=Divya Drishti obstacle detection and guidance
After=NetworkManager.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi
ExecStart=/usr/local/sbin/divyadrishti-sensing-start
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
